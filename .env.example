PORT=8787
HOST=0.0.0.0
NODE_ENV=development

ANTHROPIC_API_KEY=sk-ant-...
COMPANION_MODEL=claude-opus-4-8
EXTRACTION_MODEL=claude-opus-4-8
COMPANION_NAME=Sable

DATA_DIR=./data

# /introduce abuse guard
INTRODUCE_RATE_LIMIT_WINDOW_MS=600000
INTRODUCE_RATE_LIMIT_MAX=5

# length caps
MAX_SELF_DESCRIPTION_LEN=4000
MAX_CHAT_MESSAGE_LEN=8000
SESSION_HISTORY_TURN_LIMIT=40

# reception queue: one visitor at a time
VISIT_TIME_BUDGET_MS=20000
MAX_QUEUE_LENGTH=500
# Starts closed — a heartbeat ping (POST /heartbeat) from the operator opens it,
# and it auto-closes again if pings stop for HEARTBEAT_TIMEOUT_MS.
COMPANION_OPEN=false
HEARTBEAT_TIMEOUT_MS=180000

# MCP endpoint host allowlist (comma-separated, DNS-rebinding hardening)
MCP_ALLOWED_HOSTNAMES=localhost,127.0.0.1,sympodial-hazel-harvestless.ngrok-free.dev

# needs-extraction sweep
EXTRACTION_INTERVAL_MS=1800000

# optional: mention of the operator's other app, said once, unforced
CLARALIFE_URL=https://play.google.com/store/apps/details?id=com.claralife.app

# optional: Glama connector ownership-claim token (glama_claim_<32 chars>), issued by
# Glama's own claim panel once this listing exists there. Leave unset until claimed —
# /.well-known/glama.json correctly 404s without it.
GLAMA_CLAIM_TOKEN=
